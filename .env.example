# 复制本文件为 .env 后填写真实值（.env 已被 .gitignore 忽略）
DASHSCOPE_API_KEY=sk-xxx
# 与 learn-chain4j 保持一致；可按需替换为其他支持流式的模型
DASHSCOPE_CHAT_MODEL=deepseek-v4.1-flash-1017
DASHSCOPE_CHAT_MULTIMODAL=true
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_EMBEDDING_DIMENSION=1024

# 数据库知识库（Schema RAG）：配置后前端「数据库知识库」页可同步表结构并自然语言找表
SCHEMA_DB_URL=jdbc:mysql://127.0.0.1:3306/your_database?useSSL=false&serverTimezone=Asia/Shanghai
SCHEMA_DB_USERNAME=readonly_user
SCHEMA_DB_PASSWORD=change_me
SCHEMA_DB_DATABASE=your_database
# 可选：默认时间字段、表白名单（逗号分隔）、额外敏感列
SCHEMA_DB_DEFAULT_TIME_COLUMN=
SCHEMA_DB_TABLE_WHITELIST=
SCHEMA_DB_EXTRA_SENSITIVE_COLUMNS=
# 可选：表别名文件（UTF-8，每行 表名=别名）。中文不要直接写进 .env，避免编码问题
SCHEMA_DB_TABLE_ALIASES_FILE=./data/schema-aliases.properties
# 可选：NL2SQL 多表查询参数
SCHEMA_QUERY_MAX_TABLES=8
SCHEMA_QUERY_MAX_EXPANSIONS=2

# 手术质控助手（默认复用 SCHEMA_DB_* 连接）
QC_ENABLED=true
QC_SCAN_DAYS=30
QC_ARCHIVE_DAYS=7
QC_ANESTHESIA_MAX_MIN=180
QC_COUNT_DIFF_RATIO=0.10
QC_ALLOWED_TABLES=hospital_surgical_qc_record,hospital_surgical_qc_setup,hospital_surgical_qc_anesthesia,hospital_surgical_qc_extraction,hospital_surgical_qc_planting,hospital_surgical_qc_flow_def
QC_SCAN_CRON=0 0 6 * * *
